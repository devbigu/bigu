NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GEMINI_API_KEY=replace-with-backend-only-key
GEMINI_API_KEY_FALLBACK=
GEMINI_MODEL=gemini-3.5-flash
AI_REQUEST_TIMEOUT_MS=30000
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=
USER_AVATAR_MAX_BYTES=5242880
CLIENT_FILE_MAX_BYTES=10485760

# AI provider routing
AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDERS=gemini
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_SAFETY_MODEL=openai/gpt-oss-safeguard-20b
GROQ_REQUEST_TIMEOUT_MS=45000
